# =========================================================
# FocusSense - Git Ignore
# =========================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
venv/
.venv/
env/
ENV/

# ---------- Environment / Secrets ----------
.env
.env.*
!.env.example

# ---------- Databases ----------
*.db
*.sqlite
*.sqlite3
focus.db

# ---------- Generated logs ----------
*.log
logs/
logs/*.csv

# ---------- Generated reports ----------
reports/*.csv
reports/*.pdf
reports/*.json

# ---------- Training / Runtime Data ----------
data/*.npy
data/*.npz

# Keep the data directory itself
!data/.gitkeep

# ---------- Temporary files ----------
*.tmp
*.temp
*.bak
*.swp
*.swo

# ---------- macOS ----------
.DS_Store
.AppleDouble
.LSOverride

# ---------- IDE / Editors ----------
.vscode/
.idea/
*.code-workspace

# ---------- Jupyter ----------
.ipynb_checkpoints/

# ---------- Testing ----------
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ---------- Build / Packaging ----------
build/
dist/
*.egg-info/
.eggs/

# ---------- Node / Frontend ----------
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ---------- Flask ----------
instance/

# ---------- OS / Editor ----------
Thumbs.db

# ---------- Local configuration ----------
config.local.*
settings.local.*
